# ~/.zprofile -- login shell config
#
# Runs once per login (not per interactive shell). Put PATH and other
# environment exports HERE, not in ~/.zshrc, so they're available to
# scripts, GUI apps launched from a login shell, etc.

# ------------------------------------------------------------------------------
# Homebrew (works on both Apple Silicon and Intel)
# ------------------------------------------------------------------------------

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# ------------------------------------------------------------------------------
# PATH additions
# ------------------------------------------------------------------------------

# Personal scripts.
[[ -d "$HOME/bin" ]] && export PATH="$HOME/bin:$PATH"

# pipx-installed CLI tools.
[[ -d "$HOME/.local/bin" ]] && export PATH="$PATH:$HOME/.local/bin"

# Go.
export GOPATH="$HOME/go"
[[ -d "$GOPATH/bin" ]] && export PATH="$PATH:$GOPATH/bin"

# GNU coreutils (if installed via brew).
if command -v brew >/dev/null 2>&1; then
  if [[ -d "$(brew --prefix)/opt/coreutils/libexec/gnubin" ]]; then
    export PATH="$(brew --prefix)/opt/coreutils/libexec/gnubin:$PATH"
    export MANPATH="$(brew --prefix)/opt/coreutils/libexec/gnuman:${MANPATH-}"
  fi
fi

# ------------------------------------------------------------------------------
# Locale
# ------------------------------------------------------------------------------

export LC_ALL="en_AU.UTF-8"
export LANG="en_AU.UTF-8"

# ------------------------------------------------------------------------------
# Tool init that needs to be in a login shell
# ------------------------------------------------------------------------------

# pyenv (only if installed; you've dropped it for now but harmless to keep).
if command -v pyenv >/dev/null 2>&1; then
  export PYENV_ROOT="$HOME/.pyenv"
  eval "$(pyenv init --path)"
fi

# OrbStack shell integration (Docker/Linux VMs).
[[ -f "$HOME/.orbstack/shell/init.zsh" ]] && source "$HOME/.orbstack/shell/init.zsh"
