alias e='eksctl'

# ------------------------------------------------------------------------------
# Functions
# ------------------------------------------------------------------------------

# Custom function - specific to user mjwalf's laptop-osx Ansible setup
function laptop-osx () {
  local playbook_path="/Users/$(whoami)/Developer/config/src/github.com/mjwalf/laptop-osx/ansible/playbook.yml"
  local inventory_path="/Users/$(whoami)/Developer/config/src/github.com/mjwalf/laptop-osx/ansible/hosts"
  local current_user=$(whoami)

  if [ ! -f "$playbook_path" ] || [ ! -f "$inventory_path" ]; then
    echo "Error: Ansible playbook or inventory not found at expected location."
    echo "Playbook: $playbook_path"
    echo "Inventory: $inventory_path"
    return 1
  fi

  if [ -z "$1" ]; then
    ansible-playbook "$playbook_path" -e install_user="$current_user" -i "$inventory_path" -K
  else
    ansible-playbook "$playbook_path" -e install_user="$current_user" -i "$inventory_path" -K --tags="$1"
  fi
}

