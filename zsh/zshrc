# ~/.zshrc -- interactive shell config
#
# Login-shell environment (PATH, brew shellenv, etc.) lives in ~/.zprofile.
# Anything that should be available to non-interactive scripts also belongs
# in ~/.zprofile, NOT here.

# ------------------------------------------------------------------------------
# Editor + per-tool environment
# ------------------------------------------------------------------------------

export GPG_TTY=$(tty)

if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
elif command -v cursor >/dev/null 2>&1; then
  export EDITOR='cursor -w'
else
  export EDITOR='vim'
fi

# History (oh-my-zsh sets HISTFILE; we just bump the size).
export HISTSIZE=10000
export SAVEHIST=10000
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_EXPIRE_DUPS_FIRST

# ------------------------------------------------------------------------------
# Oh My Zsh
# ------------------------------------------------------------------------------

export ZSH="$HOME/.oh-my-zsh"

# `apple.zsh-theme` is symlinked into ~/.oh-my-zsh/custom/themes/ by the
# laptop-osx dotfiles role, so OMZ resolves it as a normal custom theme.
ZSH_THEME="apple"

COMPLETION_WAITING_DOTS="true"
HIST_STAMPS="dd/mm/yyyy"

# zsh-autosuggestions and zsh-syntax-highlighting are installed by the
# laptop-osx playbook into $ZSH/custom/plugins/.
plugins=(
  git
  github
  brew
  docker
  aws
  terraform
  kubectl
  helm
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source "$ZSH/oh-my-zsh.sh"

# ------------------------------------------------------------------------------
# Tool init
# ------------------------------------------------------------------------------

# fzf key bindings + completion (installed via brew).
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh) 2>/dev/null
fi

# ------------------------------------------------------------------------------
# SSH agent / keychain
# ------------------------------------------------------------------------------
#
# Modern macOS (Monterey+) loads keys from the keychain on demand if your
# ~/.ssh/config has `UseKeychain yes` and `AddKeysToAgent yes`. Use:
#
#     ssh-add --apple-load-keychain
#
# in a one-off if you need to preload them. Old `ssh-add -A` was removed in
# macOS Monterey.

# ------------------------------------------------------------------------------
# Aliases
# ------------------------------------------------------------------------------

# General
alias ls='ls -G'
alias l='ls -lah'
alias ll='ls -lh'
alias la='ls -a'
alias grep='grep --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias o='open'
alias lock='/System/Library/CoreServices/"Menu Extras"/User.menu/Contents/Resources/CGSession -suspend'
alias showFiles='defaults write com.apple.finder AppleShowAllFiles YES; killall Finder'
alias hideFiles='defaults write com.apple.finder AppleShowAllFiles NO; killall Finder'

# Modern replacements (provided by the laptop-osx brew list).
command -v eza >/dev/null 2>&1 && {
  alias ls='eza'
  alias l='eza -lah --git'
  alias ll='eza -lh --git'
  alias la='eza -a'
  alias tree='eza --tree'
}
command -v bat >/dev/null 2>&1 && alias cat='bat --paging=never'

# Git
alias glog="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias gcb='git checkout -b'
# Jump to the repo's default branch (works for both `main` and `master`).
alias gmain='git checkout "$(git symbolic-ref refs/remotes/origin/HEAD | sed s@^refs/remotes/origin/@@)" && git fetch && git pull'
alias master='gmain'

# Kubernetes
alias k='kubectl'
alias kctx='kubectl config use-context'
alias kget='kubectl get'
alias kdesc='kubectl describe'
alias kgp='kubectl get pods'
alias kga='kubectl get all'
alias kdep='kubectl get deployment'
alias ksvc='kubectl get service'
alias klogs='kubectl logs -f'
alias kexec='kubectl exec -it'

# Terraform
alias tf='terraform'
alias tfi='terraform init'
alias tfp='terraform plan'
alias tfa='terraform apply'
alias tfd='terraform destroy'

# AWS
alias aws-who='aws sts get-caller-identity'
alias e='eksctl'

# AWS EKS / o8t profiles. Safe to keep here -- they only affect the current
# shell when invoked.
alias dev="export AWS_PROFILE=o8t-development && aws eks update-kubeconfig --region us-west-2 --name o8t-dev-20241213"
alias staging="export AWS_PROFILE=o8t-staging && aws eks update-kubeconfig --region us-west-2 --name o8t-stag-20250210"
alias prod="export AWS_PROFILE=o8t-production && aws eks update-kubeconfig --region us-west-2 --name o8t-prod-us-20250304"
alias shared="export AWS_PROFILE=o8t-shared && aws eks update-kubeconfig --region us-west-2 --name o8t-shared-20250508"

# ------------------------------------------------------------------------------
# Functions
# ------------------------------------------------------------------------------

# Run the laptop-osx Ansible playbook. Optional first arg is a tag.
function laptop-osx() {
  local repo="${HOME}/Developer/config/src/github.com/mjwalf/laptop-osx"
  if [[ ! -f "${repo}/ansible/playbook.yml" ]]; then
    echo "laptop-osx: playbook not found at ${repo}/ansible/playbook.yml" >&2
    return 1
  fi
  if [[ -z "$1" ]]; then
    ansible-playbook "${repo}/ansible/playbook.yml" \
      -i "${repo}/ansible/hosts" \
      -e "install_user=${USER}" -K
  else
    ansible-playbook "${repo}/ansible/playbook.yml" \
      -i "${repo}/ansible/hosts" \
      -e "install_user=${USER}" -K --tags "$1"
  fi
}

# Quick weather lookup, e.g. `weather sydney`.
function weather() {
  curl -s "http://wttr.in/$1" | head -7 | tail -6
}

# ------------------------------------------------------------------------------
# Local overrides
# ------------------------------------------------------------------------------
#
# Drop machine-specific or secret config in ~/.zshrc.local; it's gitignored.
if [[ -f "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local"
fi
true
