# ~/.zshrc

# ------------------------------------------------------------------------------
# Exports and Environment Variables
# ------------------------------------------------------------------------------

# Ensure GPG works correctly with pinentry prompts in terminals
export GPG_TTY=$(tty)

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set preferred editor (use 'code -w' locally, 'vim' over SSH)
# 'code -w' waits for the file to be closed in VS Code.
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='code -w'
fi

# Go Environment (adjust GOPATH if you use a different location)
export GOPATH="$HOME/go"

# Pyenv Configuration (for Python version management)
export PYENV_ROOT="$HOME/.pyenv" # Standard path, adjust if different

# Add user bin, Homebrew bin, Go bin, Ruby bin (from Homebrew), and sbin to PATH
# Prioritize user and Homebrew paths
export PATH="$HOME/bin:/usr/local/bin:$GOPATH/bin:/usr/local/opt/ruby/bin:/usr/local/sbin:$PATH"

# Add Homebrew paths for Apple Silicon (M1/M2)
eval $(/opt/homebrew/bin/brew shellenv)


# Increase Zsh history size
export HISTSIZE=10000
export SAVEHIST=10000

# ------------------------------------------------------------------------------
# Oh My Zsh Configuration
# ------------------------------------------------------------------------------

# Zsh theme - Using a custom theme path
# Consider moving custom themes to $ZSH_CUSTOM/themes/your-theme-name
ZSH_THEME="../../.dotfiles/zsh/apple"

# Display red dots while waiting for completion? (Default: false)
COMPLETION_WAITING_DOTS="true"

# Timestamp format for history command output (e.g., "dd/mm/yyyy")
HIST_STAMPS="dd/mm/yyyy"

# Zsh History behaviour options
# HIST_IGNORE_DUPS: Don't record commands matching previous history entry.
# HIST_IGNORE_SPACE: Don't record commands starting with a space.
# HIST_EXPIRE_DUPS_FIRST: Expire duplicate entries first when trimming history.
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_EXPIRE_DUPS_FIRST

# Oh My Zsh plugins
# Ensure zsh-autosuggestions & zsh-syntax-highlighting are installed:
# git clone https://github.com/zsh-users/zsh-autosuggestions ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-autosuggestions
# git clone https://github.com/zsh-users/zsh-syntax-highlighting.git ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting
plugins=(
  git
  github
  brew
  docker
  tmux
  aws
  colorize
  terraform
  kubectl
  minikube
  helm
  zsh-autosuggestions # Provides command suggestions based on history
  zsh-syntax-highlighting # Adds syntax highlighting to the command line
)

# Load Oh My Zsh
source $ZSH/oh-my-zsh.sh

